{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", ".firebaserc", "**/.*", "**/node_modules/**",
      "server.py", "package.json", "tools/**", "slides/**", "trek_downloads/**", "tex/cache/**", ".claude/**"
    ],
    "headers": [
      { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "tex/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  }
}
